{
  "manifest_version": 3,
  "name": "Image Analysis Extension",
  "version": "1.2.0",
  "description": "Analyze images for AI generation or forensic manipulation.",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "contextMenus",
    "permissions",
    "storage"
  ],
  "host_permissions": [
    "https://mywork-production.up.railway.app/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  }
}